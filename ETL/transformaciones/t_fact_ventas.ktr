    <name>calcula_rango</name>
    <type>ScriptValueMod</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <compatible>N</compatible>
    <optimizationLevel>9</optimizationLevel>
    <jsScripts><jsScript><jsScript_type>0</jsScript_type><jsScript_name>Script 1</jsScript_name><jsScript_script>var bruta = Number(venta_bruta);
var desc = Number(descuento_cop);
var rango_descuento;
if (desc == 0) { rango_descuento = 'Sin descuento'; }
else {
  var p = desc / bruta;
  rango_descuento = (p &lt;= 0.05) ? 'Bajo' : ((p &lt;= 0.10) ? 'Medio' : 'Alto');
}</jsScript_script></jsScript></jsScripts>
    <fields><field><name>rango_descuento</name><rename>rango_descuento</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field></fields>
