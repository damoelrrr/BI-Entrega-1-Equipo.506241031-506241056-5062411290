<?xml version="1.0" encoding="UTF-8"?>
<transformation>
  <info>
    <name>t_ctx_empresas</name>
    <description>F2 Dinamica empresarial Bogota (CSV original del portal) a dw.ctx_empresas_bogota</description>
    <extended_description/>
    <trans_version/>
    <trans_type>Normal</trans_type>
    <directory>/</directory>
    <parameters><parameter><name>DB_HOST</name><default_value>localhost</default_value><description/></parameter><parameter><name>DB_PORT</name><default_value>5432</default_value><description/></parameter><parameter><name>DB_NAME</name><default_value>retailbi_dw</default_value><description/></parameter><parameter><name>DB_USER</name><default_value>postgres</default_value><description/></parameter></parameters>
    <log/>
    <maxdate><connection/><table/><field/><offset>0.0</offset><maxdiff>0.0</maxdiff></maxdate>
    <size_rowset>10000</size_rowset>
    <sleep_time_empty>50</sleep_time_empty>
    <sleep_time_full>50</sleep_time_full>
    <unique_connections>N</unique_connections>
    <feedback_shown>Y</feedback_shown>
    <feedback_size>50000</feedback_size>
    <using_thread_priorities>Y</using_thread_priorities>
    <shared_objects_file/>
    <capture_step_performance>N</capture_step_performance>
    <step_performance_capturing_delay>1000</step_performance_capturing_delay>
    <step_performance_capturing_size_limit>100</step_performance_capturing_size_limit>
    <dependencies/>
    <partitionschemas/>
    <slaveservers/>
    <clusterschemas/>
    <created_user>-</created_user>
    <modified_user>-</modified_user>
  </info>
  <notepads/>
  <connection>
    <name>retailbi_dw</name>
    <server>${DB_HOST}</server>
    <type>POSTGRESQL</type>
    <access>Native</access>
    <database>${DB_NAME}</database>
    <port>${DB_PORT}</port>
    <username>${DB_USER}</username>
    <password>${DB_PASSWORD}</password>
    <servername/>
    <data_tablespace/>
    <index_tablespace/>
    <attributes>
      <attribute><code>FORCE_IDENTIFIERS_TO_LOWERCASE</code><attribute>N</attribute></attribute>
      <attribute><code>FORCE_IDENTIFIERS_TO_UPPERCASE</code><attribute>N</attribute></attribute>
      <attribute><code>IS_CLUSTERED</code><attribute>N</attribute></attribute>
      <attribute><code>PORT_NUMBER</code><attribute>${DB_PORT}</attribute></attribute>
      <attribute><code>PRESERVE_RESERVED_WORD_CASE</code><attribute>Y</attribute></attribute>
      <attribute><code>QUOTE_ALL_FIELDS</code><attribute>N</attribute></attribute>
      <attribute><code>SUPPORTS_BOOLEAN_DATA_TYPE</code><attribute>Y</attribute></attribute>
      <attribute><code>SUPPORTS_TIMESTAMP_DATA_TYPE</code><attribute>Y</attribute></attribute>
      <attribute><code>USE_POOLING</code><attribute>N</attribute></attribute>
    </attributes>
  </connection>
  <order>
    <hop><from>lee_f2_csv</from><to>es_ciiu_corto</to><enabled>Y</enabled></hop>
    <hop><from>es_ciiu_corto</from><to>rellena_ciiu</to><enabled>Y</enabled></hop>
    <hop><from>es_ciiu_corto</from><to>es_sin_localidad</to><enabled>Y</enabled></hop>
    <hop><from>rellena_ciiu</from><to>es_sin_localidad</to><enabled>Y</enabled></hop>
    <hop><from>es_sin_localidad</from><to>marca_sin_localidad</to><enabled>Y</enabled></hop>
    <hop><from>es_sin_localidad</from><to>es_localidad_sin_tilde</to><enabled>Y</enabled></hop>
    <hop><from>marca_sin_localidad</from><to>es_localidad_sin_tilde</to><enabled>Y</enabled></hop>
    <hop><from>es_localidad_sin_tilde</from><to>normaliza_localidad</to><enabled>Y</enabled></hop>
    <hop><from>es_localidad_sin_tilde</from><to>convierte_tipos_f2</to><enabled>Y</enabled></hop>
    <hop><from>normaliza_localidad</from><to>convierte_tipos_f2</to><enabled>Y</enabled></hop>
    <hop><from>convierte_tipos_f2</from><to>escribe_ctx_empresas</to><enabled>Y</enabled></hop>
  </order>
  <step>
    <name>lee_f2_csv</name>
    <type>CsvInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <filename>${Internal.Transformation.Filename.Directory}/../../datos/raw/170b171a-19bb-46ca-83e8-3074fe7d74be.csv</filename>
    <filename_field/>
    <rownum_field/>
    <include_filename>N</include_filename>
    <separator>,</separator>
    <enclosure>"</enclosure>
    <header>Y</header>
    <buffer_size>50000</buffer_size>
    <schemaDefinition/>
    <lazy_conversion>N</lazy_conversion>
    <add_filename_result>N</add_filename_result>
    <parallel>N</parallel>
    <newline_possible>N</newline_possible>
    <encoding>UTF-8</encoding>
    <fields><field><name>id_fuente</name><type>String</type><format/><currency/><decimal/><group/><length>-1</length><precision>-1</precision><trim_type>none</trim_type></field><field><name>periodo</name><type>String</type><format/><currency/><decimal/><group/><length>-1</length><precision>-1</precision><trim_type>none</trim_type></field><field><name>mes</name><type>String</type><format/><currency/><decimal/><group/><length>-1</length><precision>-1</precision><trim_type>none</trim_type></field><field><name>localidad</name><type>String</type><format/><currency/><decimal/><group/><length>-1</length><precision>-1</precision><trim_type>none</trim_type></field><field><name>tamano_empresarial</name><type>String</type><format/><currency/><decimal/><group/><length>-1</length><precision>-1</precision><trim_type>none</trim_type></field><field><name>rama_actividad</name><type>String</type><format/><currency/><decimal/><group/><length>-1</length><precision>-1</precision><trim_type>none</trim_type></field><field><name>codigo_ciiu</name><type>String</type><format/><currency/><decimal/><group/><length>-1</length><precision>-1</precision><trim_type>none</trim_type></field><field><name>organizacion_juridica</name><type>String</type><format/><currency/><decimal/><group/><length>-1</length><precision>-1</precision><trim_type>none</trim_type></field><field><name>sexo_representante</name><type>String</type><format/><currency/><decimal/><group/><length>-1</length><precision>-1</precision><trim_type>none</trim_type></field><field><name>empresas_vigentes</name><type>String</type><format/><currency/><decimal/><group/><length>-1</length><precision>-1</precision><trim_type>none</trim_type></field><field><name>empresas_creadas</name><type>String</type><format/><currency/><decimal/><group/><length>-1</length><precision>-1</precision><trim_type>none</trim_type></field><field><name>empresas_canceladas</name><type>String</type><format/><currency/><decimal/><group/><length>-1</length><precision>-1</precision><trim_type>none</trim_type></field></fields>
    <attributes/>
    <cluster_schema/>
    <remotesteps><input></input><output></output></remotesteps>
    <GUI><xloc>80</xloc><yloc>160</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>es_ciiu_corto</name>
    <type>FilterRows</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <send_true_to>rellena_ciiu</send_true_to>
    <send_false_to>es_sin_localidad</send_false_to>
    <compare><condition><negated>N</negated><leftvalue>codigo_ciiu</leftvalue><function>REGEXP</function><rightvalue/><value><name>constant</name><type>String</type><text>[0-9]{1,3}</text><length>-1</length><precision>-1</precision><isnull>N</isnull><mask/></value></condition></compare>
    <attributes/>
    <cluster_schema/>
    <remotesteps><input></input><output></output></remotesteps>
    <GUI><xloc>240</xloc><yloc>160</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>rellena_ciiu</name>
    <type>StringOperations</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <fields><field><in_stream_name>codigo_ciiu</in_stream_name><out_stream_name/><trim_type>none</trim_type><lower_upper>none</lower_upper><padding_type>left</padding_type><pad_char>0</pad_char><pad_len>4</pad_len><init_cap>no</init_cap><mask_xml>none</mask_xml><digits>none</digits><remove_special_characters>none</remove_special_characters></field></fields>
    <attributes/>
    <cluster_schema/>
    <remotesteps><input></input><output></output></remotesteps>
    <GUI><xloc>240</xloc><yloc>300</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>es_sin_localidad</name>
    <type>FilterRows</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <send_true_to>marca_sin_localidad</send_true_to>
    <send_false_to>es_localidad_sin_tilde</send_false_to>
    <compare><condition><negated>N</negated><leftvalue>localidad</leftvalue><function>=</function><rightvalue/><value><name>constant</name><type>String</type><text>Sin Localidad</text><length>-1</length><precision>-1</precision><isnull>N</isnull><mask/></value></condition></compare>
    <attributes/>
    <cluster_schema/>
    <remotesteps><input></input><output></output></remotesteps>
    <GUI><xloc>400</xloc><yloc>160</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>marca_sin_localidad</name>
    <type>ValueMapper</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <field_to_use>localidad</field_to_use>
    <target_field/>
    <non_match_default/>
    <fields><field><source_value>Sin Localidad</source_value><target_value>Sin localidad</target_value></field></fields>
    <attributes/>
    <cluster_schema/>
    <remotesteps><input></input><output></output></remotesteps>
    <GUI><xloc>400</xloc><yloc>300</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>es_localidad_sin_tilde</name>
    <type>FilterRows</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <send_true_to>normaliza_localidad</send_true_to>
    <send_false_to>convierte_tipos_f2</send_false_to>
    <compare><condition><negated>N</negated><leftvalue>localidad</leftvalue><function>IN LIST</function><rightvalue/><value><name>constant</name><type>String</type><text>Usaquen;Engativa;Fontibon;Los Martires;Ciudad Bolivar;San Cristobal;Candelaria</text><length>-1</length><precision>-1</precision><isnull>N</isnull><mask/></value></condition></compare>
    <attributes/>
    <cluster_schema/>
    <remotesteps><input></input><output></output></remotesteps>
    <GUI><xloc>560</xloc><yloc>160</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>normaliza_localidad</name>
    <type>ValueMapper</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <field_to_use>localidad</field_to_use>
    <target_field/>
    <non_match_default/>
    <fields><field><source_value>Usaquen</source_value><target_value>Usaquén</target_value></field><field><source_value>Engativa</source_value><target_value>Engativá</target_value></field><field><source_value>Fontibon</source_value><target_value>Fontibón</target_value></field><field><source_value>Los Martires</source_value><target_value>Los Mártires</target_value></field><field><source_value>Ciudad Bolivar</source_value><target_value>Ciudad Bolívar</target_value></field><field><source_value>San Cristobal</source_value><target_value>San Cristóbal</target_value></field><field><source_value>Candelaria</source_value><target_value>La Candelaria</target_value></field></fields>
    <attributes/>
    <cluster_schema/>
    <remotesteps><input></input><output></output></remotesteps>
    <GUI><xloc>560</xloc><yloc>300</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>convierte_tipos_f2</name>
    <type>SelectValues</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <fields><select_unspecified>N</select_unspecified><meta><name>id_fuente</name><rename>id_fuente</rename><type>Integer</type><length>-1</length><precision>-1</precision><conversion_mask></conversion_mask><date_format_lenient>false</date_format_lenient><date_format_locale/><date_format_timezone/><lenient_string_to_number>false</lenient_string_to_number><encoding/><decimal_symbol/><grouping_symbol/><currency_symbol/><storage_type/></meta><meta><name>mes</name><rename>mes</rename><type>Integer</type><length>-1</length><precision>-1</precision><conversion_mask></conversion_mask><date_format_lenient>false</date_format_lenient><date_format_locale/><date_format_timezone/><lenient_string_to_number>false</lenient_string_to_number><encoding/><decimal_symbol/><grouping_symbol/><currency_symbol/><storage_type/></meta><meta><name>empresas_vigentes</name><rename>empresas_vigentes</rename><type>Integer</type><length>-1</length><precision>-1</precision><conversion_mask></conversion_mask><date_format_lenient>false</date_format_lenient><date_format_locale/><date_format_timezone/><lenient_string_to_number>false</lenient_string_to_number><encoding/><decimal_symbol/><grouping_symbol/><currency_symbol/><storage_type/></meta><meta><name>empresas_creadas</name><rename>empresas_creadas</rename><type>Integer</type><length>-1</length><precision>-1</precision><conversion_mask></conversion_mask><date_format_lenient>false</date_format_lenient><date_format_locale/><date_format_timezone/><lenient_string_to_number>false</lenient_string_to_number><encoding/><decimal_symbol/><grouping_symbol/><currency_symbol/><storage_type/></meta><meta><name>empresas_canceladas</name><rename>empresas_canceladas</rename><type>Integer</type><length>-1</length><precision>-1</precision><conversion_mask></conversion_mask><date_format_lenient>false</date_format_lenient><date_format_locale/><date_format_timezone/><lenient_string_to_number>false</lenient_string_to_number><encoding/><decimal_symbol/><grouping_symbol/><currency_symbol/><storage_type/></meta></fields>
    <attributes/>
    <cluster_schema/>
    <remotesteps><input></input><output></output></remotesteps>
    <GUI><xloc>720</xloc><yloc>160</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>escribe_ctx_empresas</name>
    <type>TableOutput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <connection>retailbi_dw</connection>
    <schema>dw</schema>
    <table>ctx_empresas_bogota</table>
    <commit>1000</commit>
    <truncate>Y</truncate>
    <ignore_errors>N</ignore_errors>
    <use_batch>Y</use_batch>
    <specify_fields>Y</specify_fields>
    <partitioning_enabled>N</partitioning_enabled>
    <partitioning_field/>
    <partitioning_daily>N</partitioning_daily>
    <partitioning_monthly>Y</partitioning_monthly>
    <tablename_in_field>N</tablename_in_field>
    <tablename_field/>
    <tablename_in_table>Y</tablename_in_table>
    <return_keys>N</return_keys>
    <return_field/>
    <fields><field><column_name>id_fuente</column_name><stream_name>id_fuente</stream_name></field><field><column_name>periodo</column_name><stream_name>periodo</stream_name></field><field><column_name>mes</column_name><stream_name>mes</stream_name></field><field><column_name>localidad</column_name><stream_name>localidad</stream_name></field><field><column_name>tamano_empresarial</column_name><stream_name>tamano_empresarial</stream_name></field><field><column_name>rama_actividad</column_name><stream_name>rama_actividad</stream_name></field><field><column_name>codigo_ciiu</column_name><stream_name>codigo_ciiu</stream_name></field><field><column_name>organizacion_juridica</column_name><stream_name>organizacion_juridica</stream_name></field><field><column_name>empresas_vigentes</column_name><stream_name>empresas_vigentes</stream_name></field><field><column_name>empresas_creadas</column_name><stream_name>empresas_creadas</stream_name></field><field><column_name>empresas_canceladas</column_name><stream_name>empresas_canceladas</stream_name></field></fields>
    <attributes/>
    <cluster_schema/>
    <remotesteps><input></input><output></output></remotesteps>
    <GUI><xloc>880</xloc><yloc>160</yloc><draw>Y</draw></GUI>
  </step>
  <step_error_handling/>
  <slave-step-copy-partition-distribution/>
  <slave_transformation>N</slave_transformation>
</transformation>
